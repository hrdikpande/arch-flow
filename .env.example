# arch-flow environment. Copy to .env (local) or add the same names in Vercel → Project → Settings → Environment Variables.
# Never commit .env. Never paste these values into code, issues or chat.

# ---- App ----
APP_URL=http://localhost:3000
UPLOAD_MAX_MB=200

# ---- Supabase (database, auth, storage) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Messaging: who sends WhatsApp messages ----
# "web"   = the WhatsApp Web process (apps/whatsapp-web) sends the owner/internal alerts. Vercel only queues.
# "cloud" = this app sends through the WhatsApp Cloud API (client-facing messages, production).
# unset   = nothing is sent. Events are still recorded.
MESSAGING_TRANSPORT=web

# ---- WhatsApp Web session process (pilot, dedicated test number only) ----
# Run on a machine that stays on: npm start -w @arch-flow/whatsapp-web
# Generate the key once: openssl rand -base64 32   (keep it safe: losing it means re-scanning the QR code)
WA_SESSION_KEY=
WA_SESSION_NAME=arch-flow-pilot
WA_CHROMIUM_PATH=
WA_FLUSH_SECONDS=15

# ---- WhatsApp Cloud API (Meta) ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=arch_flow_update
WHATSAPP_TEMPLATE_LANGUAGE=en

# ---- Vercel cron protection (any long random string) ----
CRON_SECRET=

# ---- Gemini (digest wording only; optional) ----
GEMINI_API_KEY=
GEMINI_MODEL=

# ---- Autodesk Platform Services (CAD translation and viewer) ----
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_BUCKET_KEY=
APS_REGION=US
APS_VIEWER_VERSION=7.*
