# ---- Web app (Netlify) and worker (Hostinger) ----
# Supabase project (India region, O-A4). Use the staging project for development.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Never commit.
SUPABASE_SERVICE_ROLE_KEY=
# Public address of the web app. Used in emails, links and WhatsApp messages.
APP_URL=http://localhost:3000
# Upload limit in MB, from the Supabase plan (O-A9).
UPLOAD_MAX_MB=500

# ---- Worker only (Hostinger VPS) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
WA_ENABLED=true
WA_SESSION_PATH=./apps/worker/.wwebjs_auth
# Chromium path inside the Docker image (see apps/worker/Dockerfile).
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PORT=8080

# ---- Gemini digest text (optional). Leave both empty until a model is pinned (Phase 8). ----
GEMINI_API_KEY=
GEMINI_MODEL=
