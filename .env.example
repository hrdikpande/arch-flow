# arch-flow environment. Copy to .env (local) or add the same names in Vercel → Project → Settings → Environment Variables.
# Never commit .env. Never paste these values into code, issues or chat.

# ---- App ----
APP_URL=http://localhost:3000
UPLOAD_MAX_MB=200

# ---- Supabase (database, auth, storage) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- WhatsApp Cloud API (Meta) ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=arch_flow_update
WHATSAPP_TEMPLATE_LANGUAGE=en

# ---- Vercel cron protection (any long random string) ----
CRON_SECRET=

# ---- Gemini (digest wording only; optional) ----
GEMINI_API_KEY=
GEMINI_MODEL=

# ---- Autodesk Platform Services (CAD translation and viewer) ----
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_BUCKET_KEY=
APS_REGION=US
APS_VIEWER_VERSION=7.*
