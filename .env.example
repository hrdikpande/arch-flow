# =============================================================================
# arch-flow environment. Copy this file to .env on each machine that runs the code.
# On Vercel, add the same names under Project → Settings → Environment Variables.
# Never commit .env. Never paste these values into code, issues or chat.
#
# Each section says where it is needed:
#   [ALL]        the web app (Vercel or local) and the WhatsApp Web host
#   [VERCEL]     the web app only
#   [WA-HOST]    the WhatsApp Web process only (apps/whatsapp-web), on the always-on machine
#   [CLOUD]      only when MESSAGING_TRANSPORT=cloud (client-facing WhatsApp via Meta)
#   [APS]        Autodesk translation and viewing (CAD files)
#   [GEMINI]     optional digest wording
# =============================================================================

# ---- [ALL] Supabase project (database, auth, storage) ----
# Share the project URL with the team; the keys are copied from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- [ALL] Public URL of the web app (used in WhatsApp message links) ----
APP_URL=http://localhost:3000

# ---- [VERCEL] App settings ----
UPLOAD_MAX_MB=200
# Who sends WhatsApp messages: "web" (WhatsApp Web host sends; Vercel only queues),
# "cloud" (Vercel sends through the Cloud API), or unset (nothing is sent).
MESSAGING_TRANSPORT=web
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Any long random string.
CRON_SECRET=

# ---- [WA-HOST] WhatsApp Web session process (pilot, dedicated test number only) ----
# Generate once with: openssl rand -base64 32. Losing it means the stored session cannot be read,
# so the QR code has to be scanned again.
WA_SESSION_KEY=
WA_SESSION_NAME=arch-flow-pilot
# Path to a Chromium or Chrome binary on the host. Leave empty to use the one whatsapp-web.js finds.
WA_CHROMIUM_PATH=
# How often the host sends queued messages.
WA_FLUSH_SECONDS=15

# ---- [CLOUD] WhatsApp Cloud API (Meta). Needed for client-facing messages in production. ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=arch_flow_update
WHATSAPP_TEMPLATE_LANGUAGE=en

# ---- [APS] Autodesk Platform Services (CAD translation and viewing) ----
APS_CLIENT_ID=
APS_CLIENT_SECRET=
# Bucket that holds uploaded CAD files. Created on first use if it does not exist.
APS_BUCKET_KEY=
# Viewer API for the data region: "streamingV2" (default, US) or "streamingV2_EU" (EMEA data).
NEXT_PUBLIC_APS_VIEWER_API=streamingV2

# ---- [GEMINI] Optional digest wording. Output is checked against the source data. ----
GEMINI_API_KEY=
GEMINI_MODEL=

# ---- [ALL] Test only (Playwright and the API harness). Not needed in production. ----
# E2E_PORT=3100
# ARCHFLOW_API_PORT=3401
